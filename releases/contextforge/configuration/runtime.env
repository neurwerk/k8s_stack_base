HOST=0.0.0.0
PORT=4444
ENVIRONMENT=production
AUTH_REQUIRED=true
EMAIL_AUTH_ENABLED=true
API_ALLOW_BASIC_AUTH=false
DOCS_ALLOW_BASIC_AUTH=false
TRUST_PROXY_AUTH=false
SECURE_COOKIES=true
CSRF_ENABLED=true
# For each new MCP, first verify modern tool discovery, authentication and real calls before enabling its route.
# For missing schema-derived headers, check upstream fixes before considering compatibility mode, which affects all upstream MCP connections.
MCP_INBOUND_PROTOCOL_MODE=auto
MCP_CLIENT_CONNECT_MODE=auto
CACHE_TYPE=none
OAUTH_TOKEN_BACKEND=vault
VAULT_ADDR=https://infra-openbao.infra-openbao.svc:8200
VAULT_KV_MOUNT=secret
VAULT_KV_PATH_PREFIX=contextforge/oauth
VAULT_TLS_VERIFY=true
VAULT_TOKEN_CACHE_ENABLED=false
VAULT_TOKEN_CACHE_MAX_SIZE=0
LOG_LEVEL=WARNING
LOG_REQUESTS=false
LOG_TO_FILE=false
DISABLE_ACCESS_LOG=true
DEBUG=false
EXPOSE_ERROR_DETAILS=false
OTEL_ENABLE_OBSERVABILITY=false
