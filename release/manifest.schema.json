{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurwerk.com/schemas/platform-release-v1.json",
  "title": "Neurwerk Platform Release",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/commit"}
    },
    "bootstrapProvenance": {
      "type": "object",
      "required": ["bootstrap", "includedThrough", "commits", "historyUrl"],
      "properties": {
        "bootstrap": {"const": true},
        "includedThrough": {"$ref": "#/$defs/commit"},
        "commits": {"$ref": "#/$defs/commits"},
        "historyUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/neurwerk/k8s_stack_base/commits/[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    },
    "predecessorProvenance": {
      "type": "object",
      "required": ["previousTag", "includedThrough", "commits", "compareUrl"],
      "properties": {
        "previousTag": {
          "type": "string",
          "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "includedThrough": {"$ref": "#/$defs/commit"},
        "commits": {"$ref": "#/$defs/commits"},
        "compareUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/neurwerk/k8s_stack_base/compare/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.\\.\\.[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "apiVersion": {"const": "platform.neurwerk.com/v1alpha1"},
    "kind": {"const": "PlatformRelease"},
    "metadata": {
      "type": "object",
      "required": ["name"]
    },
    "spec": {
      "type": "object",
      "required": [
        "version",
        "releaseDate",
        "summary",
        "trust",
        "compatibility",
        "packages",
        "prerequisites",
        "artifacts"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "releaseDate": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          ]
        },
        "compatibility": {
          "type": "object",
          "required": ["freshInstall", "upgradesFrom", "downgrade", "recovery"],
          "properties": {
            "freshInstall": {
              "enum": ["supported", "unsupported"]
            },
            "upgradesFrom": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            },
            "downgrade": {
              "const": "unsupported"
            },
            "recovery": {
              "enum": [
                "configuration-revert",
                "forward-fix",
                "component-native-restore",
                "replacement-restore"
              ]
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "oneOf": [
            {"$ref": "#/$defs/bootstrapProvenance"},
            {"$ref": "#/$defs/predecessorProvenance"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "version": {"const": "0.0.0"}
            },
            "required": ["version"]
          },
          "then": {
            "properties": {
              "releaseDate": {"type": "null"}
            },
            "not": {"required": ["provenance"]}
          },
          "else": {
            "required": ["provenance"],
            "properties": {
              "releaseDate": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "version": {"const": "0.1.0"}
            },
            "required": ["version"]
          },
          "then": {
            "properties": {
              "provenance": {"$ref": "#/$defs/bootstrapProvenance"}
            }
          },
          "else": {
            "if": {
              "properties": {
                "version": {"not": {"const": "0.0.0"}}
              },
              "required": ["version"]
            },
            "then": {
              "properties": {
                "provenance": {"$ref": "#/$defs/predecessorProvenance"}
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
