{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "infraAgentgatewayWrapper": {
      "type": "object",
      "properties": {
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "image": {"type": "string"},
            "resources": {"type": "object"},
            "kubernetesApiEgress": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["cidr", "port"],
                "properties": {
                  "cidr": {"type": "string", "pattern": "^([0-9.]+/32|[0-9a-fA-F:]+/128)$"},
                  "port": {"type": "integer", "minimum": 1, "maximum": 65535}
                }
              }
            }
          }
        }
      }
    }
  }
}
