{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "forgejo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "hostname": {"type": "string"},
        "recoveryLoginEnabled": {"type": "boolean"},
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "caConfigMap": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}
          }
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageClass": {"type": "string", "minLength": 1},
            "size": {"type": "string", "minLength": 1}
          },
          "required": ["storageClass", "size"]
        },
        "resources": {"type": "object"},
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgresPodPort": {"type": "integer", "minimum": 1, "maximum": 65535},
            "postgresPodSelector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
            "clients": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "namespace": {"type": "string", "minLength": 1},
                  "podSelector": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
                },
                "required": ["namespace", "podSelector"]
              }
            },
            "keycloakPublicCidrs": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "externalGateway": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"const": 443}
      }
    },
    "publicCertificates": {
      "type": "object",
      "properties": {"useProduction": {"type": "boolean"}}
    },
    "canonicalEndpointRouting": {
      "type": "object",
      "properties": {"mode": {"enum": ["internal-traefik", "public-dns"]}}
    }
  }
}
