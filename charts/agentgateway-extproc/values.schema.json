{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "monitorAgentgatewayExtproc": {
      "type": "object",
      "properties": {
        "logging": {
          "type": "object",
          "properties": {
            "errorLevel": {"type": "string", "enum": ["info", "debug"]}
          }
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxFingerprints"],
      "properties": {
        "maxFingerprints": {"type": "integer", "minimum": 1}
      }
    }
  }
}
