{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "docling": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "mode": {"type": "string", "enum": ["internal", "external"]},
        "inference": false,
        "external": {
          "type": "object",
          "properties": {
            "url": {"type": "string"},
            "allowHttp": {"type": "boolean"},
            "cidrs": {"type": "array", "items": {"type": "string"}},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "caConfigMap": {"type": "string"}
          }
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "host": {"type": "string"}
          }
        },
        "batches": {
          "type": "object",
          "required": ["ocr", "layout", "table"],
          "additionalProperties": false,
          "properties": {
            "ocr": {"type": "integer", "minimum": 1},
            "layout": {"type": "integer", "minimum": 1},
            "table": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "publicCertificates": {
      "type": "object",
      "properties": {"useProduction": {"type": "boolean"}}
    }
  }
}
