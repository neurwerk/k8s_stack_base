{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "authKeycloak": {
      "type": "object",
      "properties": {
        "activeDirectory": {
          "type": "object",
          "properties": {
            "directoryGroups": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "excludePrefixes"],
              "properties": {
                "enabled": {"type": "boolean"},
                "excludePrefixes": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 64}
                }
              }
            }
          }
        }
      }
    }
  }
}
