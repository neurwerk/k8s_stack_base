{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "monitorPiiEngine": {
      "type": "object",
      "properties": {
        "nerCache": {"$ref": "#/definitions/nerCache"},
        "ner": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/definitions/ner"}
          ]
        }
      }
    }
  },
  "definitions": {
    "nerCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxBytes", "ttlSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "maxBytes": {"type": "integer", "minimum": 1},
        "ttlSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "ner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["disabled", "local", "remote"]},
        "languageModels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "en": {"$ref": "#/definitions/modelId"},
            "de": {"$ref": "#/definitions/modelId"},
            "nl": {"$ref": "#/definitions/modelId"}
          }
        },
        "models": {
          "type": "object",
          "maxProperties": 3,
          "propertyNames": {"$ref": "#/definitions/modelId"},
          "additionalProperties": {"$ref": "#/definitions/model"}
        },
        "capacity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "callTimeout": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
            "maxCalls": {"type": "integer", "minimum": 1, "maximum": 10000},
            "maxResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 8388608},
            "maxConcurrentCalls": {"type": "integer", "minimum": 1, "maximum": 16}
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cidr", "port"],
            "properties": {
              "cidr": {
                "type": "string",
                "pattern": "^((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])/32|[0-9a-fA-F:]+/128)$"
              },
              "port": {"type": "integer", "minimum": 1, "maximum": 65535}
            }
          }
        },
        "tokenizerClaimName": {"type": "string", "maxLength": 253}
      }
    },
    "modelId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "endpoint": {"type": "string", "pattern": "^https?://[^/?#@\\s]+(/[^?#\\s]*)?$"},
        "modelName": {"$ref": "#/definitions/modelId"},
        "upstream": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "inferenceThreshold": {"type": "number", "minimum": 0, "maximum": 1},
        "allowPrivateHttp": {"type": "boolean"},
        "tokenizerPath": {"type": "string", "pattern": "^/remote-tokenizers/[^\\s]+$"},
        "apiKeySecretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
            "key": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9._-]+$"}
          }
        }
      }
    }
  }
}
