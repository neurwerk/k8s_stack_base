{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "monitorKubePrometheusStack": {
      "type": "object",
      "properties": {
        "alerting": {
          "type": "object",
          "properties": {
            "email": {
              "type": "object",
              "properties": {
                "applicationErrors": {
                  "type": "object",
                  "properties": {
                    "verifiedGlitchtipScopeIds": {
                      "type": "array", "maxItems": 32, "uniqueItems": true,
                      "items": {"$ref": "#/definitions/identifier"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "glitchtip": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "adapter": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "scopes": {
              "type": "array", "maxItems": 32,
              "items": {
                "type": "object",
                "required": ["id", "application", "namespaces", "containers", "failure_types"],
                "properties": {
                  "id": {"$ref": "#/definitions/identifier"},
                  "application": {"$ref": "#/definitions/identifier"},
                  "namespaces": {"$ref": "#/definitions/selection"},
                  "containers": {"$ref": "#/definitions/selection"},
                  "failure_types": {"$ref": "#/definitions/selection"}
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "identifier": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "selection": {
      "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true,
      "items": {"$ref": "#/definitions/identifier"}
    }
  }
}
