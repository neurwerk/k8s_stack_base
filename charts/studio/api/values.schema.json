{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "frontendStudio": {
      "type": "object",
      "properties": {
        "usage": {
          "type": "object",
          "required": ["enabled", "collectorImage", "prometheusUrl", "prometheusUpSelector", "scrapeSeconds", "mcpPricing", "resources"],
          "properties": {
            "enabled": {"type": "boolean"},
            "collectorImage": {"type": "string"},
            "prometheusUrl": {"type": "string", "pattern": "^https?://"},
            "prometheusUpSelector": {"type": "string", "minLength": 1},
            "scrapeSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "mcpPricing": {
              "type": "object",
              "required": ["accounts"],
              "properties": {"accounts": {"type": "array", "maxItems": 200}}
            },
            "resources": {"type": "object"}
          },
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {
            "properties": {
              "collectorImage": {"pattern": "^ghcr\\.io/neurwerk/k8s-stack-studio-collector:[0-9]+\\.[0-9]+\\.[0-9]+@sha256:[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  }
}
